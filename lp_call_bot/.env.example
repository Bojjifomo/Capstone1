# Token dari @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-xxxx

# User ID Telegram lu (bisa lebih dari satu, pisah koma). Belum tau? Jalanin bot, kirim /id.
OWNER_IDS=

# Channel buat follower (opsional). Bot harus jadi admin channel. @username atau -100xxxx
CHANNEL_IDS=

# Range kalau pas open nggak ditulis
DEFAULT_RANGE=-65

# ---- Auto call dari wallet (opsional; kosong = cuma call manual) ----
# Wallet lu (alamat publik 0x..., BUKAN private key). Bisa lebih dari satu, pisah koma.
WALLET_ADDRESSES=
# RPC Robinhood Chain. RPC_URL (buat baca log) boleh KOSONG: otomatis pakai RPC publik
# https://rpc.mainnet.chain.robinhood.com. CALL_RPC_URL (buat baca harga) boleh API key Alchemy atau link penuh.
# Jangan isi kunci Alchemy yang sama di dua-duanya: paket gratis Alchemy ngebatasin rentang eth_getLogs.
# CALL_SPLIT=rpc1 (hapus # buat nyalain): RPC publik dipakai dulu, Alchemy cuma cadangan.
# CALL_SPLIT=rpc1
RPC_URL=
CALL_RPC_URL=
# 1 = tes dulu: call otomatis cuma dikirim ke owner, belum ke follower / channel
AUTO_DRY_RUN=0
# Range dibulatin ke kelipatan ini (5: -71.3% -> -70). 1 = angka persis dari chain.
AUTO_RANGE_STEP=5
# Detik antar cek wallet
AUTO_POLL_SECONDS=15
# Bot mati lebih lama dari ini (menit)? Aktivitas yang lebih lama dari itu dilewatin, nggak dikirim ke follower
AUTO_CATCHUP_MINUTES=30
