# Token dari @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-xxxx

# User ID Telegram lu (bisa lebih dari satu, pisah koma). Belum tau? Jalanin bot, kirim /id.
OWNER_IDS=

# Channel buat follower (opsional). Bot harus jadi admin channel. @username atau -100xxxx
CHANNEL_IDS=

# Tiap berapa menit blast rekap posisi yang masih kebuka (tanpa nilai). 0 = mati.
RECAP_MINUTES=60
# Pas bot nyala (dan /sinkron): posisi yang masih kebuka disusun ulang dari chain, mundur segini hari
RECAP_SYNC_DAYS=7

# Range kalau pas open nggak ditulis
DEFAULT_RANGE=-65

# ---- Auto call dari wallet (opsional; kosong = cuma call manual) ----
# Wallet lu (alamat publik 0x..., BUKAN private key). Bisa lebih dari satu, pisah koma. Call-nya tanpa nama.
# Wallet orang lain ditambah lewat Telegram: /wallet add 0x… nama (call-nya bertanda nama itu).
WALLET_ADDRESSES=
# RPC Robinhood Chain, cuma dibaca dari file ini (nggak minjem punya rh_wallet_finder).
# RPC_URL = utama. Kosong = RPC publik https://rpc.mainnet.chain.robinhood.com
RPC_URL=
# Cadangan, pisah koma, urut prioritas: baru kepake kalau yang di depannya error / kena limit / kuota habis.
# Contoh: https://rpc.solidrpc.io/ak_xxxx/evm/4663,key-alchemy-lu   (key Alchemy doang otomatis jadi link-nya)
BACKUP_RPC_URLS=
# (lama, masih jalan) satu cadangan lagi, misal key Alchemy
CALL_RPC_URL=
# 1 = tes dulu: call otomatis cuma dikirim ke owner, belum ke follower / channel
AUTO_DRY_RUN=0
# Range dibulatin ke kelipatan ini (5: -71.3% -> -70). 1 = angka persis dari chain.
AUTO_RANGE_STEP=5
# Detik antar cek wallet. Tiap cek = 2 panggilan RPC (nomor block + 1 log), plus 1 per transaksi buka/tutup.
# 20 detik = ±8.700/hari, 30 = ±5.800/hari. /auto nunjukin pemakaian aslinya.
AUTO_POLL_SECONDS=20
# Bot mati lebih lama dari ini (menit)? Aktivitas yang lebih lama dari itu dilewatin, nggak dikirim ke follower
AUTO_CATCHUP_MINUTES=30
