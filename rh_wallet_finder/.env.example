# Copy to .env (git-ignored) or use ⚙ Settings in the dashboard.
# Robinhood Chain (4663) RPC. Needs eth_getLogs and archive eth_call.
RPC_URL=https://rpc.solidrpc.io/ak_YOUR_KEY/evm/4663
# Optional: a second RPC for archive eth_call / multicalls (e.g. Alchemy).
CALL_RPC_URL=
# Optional: LP Agent API key (LP Agent portal) to compare their numbers.
LPAGENT_API_KEY=
# History to load and the metrics window, in days.
BACKFILL_DAYS=30
METRIC_DAYS=30
# Real PnL: slippage charged when selling back the token side, on top of the pool fee.
SELL_SLIPPAGE_PCT=1.0
MIN_CLOSED=3
SCORE_POSITIONS_PER_RUN=4000
RPC_WORKERS=6
# Pool finder (Pools tab / finder.py pools): its own RPC, never the two above.
# Empty = Robinhood's public RPC. Needs eth_getLogs over ~1,000+ blocks.
POOLS_RPC_URL=
# Optional CoinGecko API key for pool data (faster than the free GeckoTerminal API); plan demo or pro.
POOLS_CG_API_KEY=
POOLS_CG_PLAN=demo
