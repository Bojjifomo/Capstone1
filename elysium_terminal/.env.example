# Elysium Terminal. Copy to elysium_terminal/.env (never commit that file).
# Fill in after the "=", no spaces, no quotes. Save, then click the key chip (no restart).
# This file is separate from rh_terminal/.env. RH_PRIVATE_KEY is not read.

# Private key of the Elysium LP wallet (64 hex, 0x optional). Use a wallet that only holds
# what you are willing to risk. The Node executor is the only process that reads it.
ELYSIUM_PRIVATE_KEY=

# Alchemy key for Elysium (https://elysium-mainnet.g.alchemy.com/v2/KEY). Empty = the public RPC,
# which is shared and rate-limited. Reads try the public RPC first either way.
ALCHEMY_API_KEY=

# Optional override. Empty = public RPC, then Alchemy.
ELYSIUM_RPC_URL=

# true = every button only simulates (eth_call). Nothing is sent. This is the default even if
# the line is missing. Set false only after a practice run of each button.
ELYSIUM_PRACTICE_MODE=true

# PIN so a phone / MacBook over Tailscale can trade. Empty = trading only from this Mac.
ELYSIUM_WEB_PIN=

# Empty = 8893, so this can run next to RH Terminal on 8892.
ELYSIUM_WEB_PORT=

# LP bankroll in dollars and the default ladder size (capped at bankroll x 5% / 0.9).
ELYSIUM_BANKROLL_USD=
ELYSIUM_SIZE_USD=

# Wallet to show in Portfolio when no key is set (read-only).
ELYSIUM_WALLET=

# Optional Telegram for PING / auto-exit (bot from @BotFather, chat id from @userinfobot).
ELYSIUM_TG_BOT_TOKEN=
ELYSIUM_TG_CHAT_ID=
