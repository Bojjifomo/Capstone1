# Salin file ini jadi notify.env (satu folder sama surge_alert.py), isi yang mau dipakai.

# GMGN API key (disarankan): sumber "semua koin" yang disaring mcap & LP langsung di server GMGN,
# plus candle-nya. Bikin di https://gmgn.ai/ai (langkahnya di README). Kosong = pakai GeckoTerminal.
GMGN_API_KEY=

# ntfy (paling gampang): install app ntfy di HP, subscribe ke nama topic yang sama.
# Topic ntfy itu publik, jadi bikin nama yang susah ditebak.
NTFY_TOPIC=

# Telegram: token dari @BotFather, chat id dari @userinfobot. Kirim /start ke bot kamu dulu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: URL webhook channel.
DISCORD_WEBHOOK_URL=

# Notif desktop Mac (bunyi). Isi 0 buat matiin.
MAC_NOTIFY=1
