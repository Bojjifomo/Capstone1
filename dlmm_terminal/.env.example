# DLMM terminal — settings. Copy of this file lives at dlmm_terminal/.env (never committed).
# Fill in after the "=", no spaces, no quotes. Save, then restart:  python3 -m dlmm_terminal web

# Private key of the wallet that trades (Phantom: Settings > Manage Accounts > Show Private Key).
# Use a wallet only for LP, holding what you are willing to risk.
DLMM_PRIVATE_KEY=

# Solana RPC (Helius): https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# Optional: a PIN so the phone (over Tailscale) can trade too. Empty = trading only from this Mac.
DLMM_WEB_PIN=

# Your modal for LP, in SOL. Sets the max per position: bankroll x 5% / 0.9 (160 SOL -> 8.89 SOL).
DLMM_BANKROLL_SOL=
# Default size per ladder, in SOL (capped by the max above). Empty = 8.
DLMM_SIZE_SOL=

# Optional: a wallet to show in Portfolio when no key is set (read-only).
DLMM_WALLET=

# Optional: Telegram for alerts (monitor) and entry pings (signal). Bot from @BotFather; chat id from
# @userinfobot (your own) or the group's id. Needed for the 24/7 signal on the Mac mini (install_signal.sh).
DLMM_TG_BOT_TOKEN=
DLMM_TG_CHAT_ID=

# Opsional: key Jupiter (portal.jup.ag). Tanpa key pakai lite-api gratis (kadang rate limit);
# kalau Jupiter gagal, penjualan token otomatis lewat pool Meteora.
JUPITER_API_KEY=
