# Copy to .env (git-ignored) or use Settings in the dashboard.
# Elysium (99901). The public RPC does eth_getLogs and archive eth_call.
# Leave RPC_URL empty to use the public endpoint below.
RPC_URL=https://rpc.elysium.kinetiq.xyz
# Optional second RPC (an Alchemy API key alone is enough).
CALL_RPC_URL=
# 0 = load from block 1. The chain's genesis is 19 Oct 2026.
BACKFILL_DAYS=0
METRIC_DAYS=30
# One closed position is enough while the chain is young.
MIN_CLOSED=1
ACTIVE_DAYS=7
EARLY_MINUTES=30
SELL_SLIPPAGE_PCT=1.0
SCORE_POSITIONS_PER_RUN=4000
RPC_WORKERS=4
