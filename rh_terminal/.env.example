# RH Terminal: settings. A copy of this file lives at rh_terminal/.env (never committed).
# Fill in after the "=", no spaces, no quotes. Save, then click the 🔒 chip in the page (no restart).
#
# Already have RH Secrets in Scriptable (iCloud Drive)? Leave the keys below EMPTY:
# RH Terminal reads PRIVATE_KEY, ALCHEMY_API_KEY and PRACTICE_MODE from it, same as the phone.

# Private key of the wallet that trades (64 hex, 0x optional). Use an LP-only wallet holding what
# you are willing to risk. It is read by the Node executor only; the browser never sees it.
RH_PRIVATE_KEY=

# Alchemy key (Robinhood chain) for sending transactions. Empty = the chain's public RPC.
ALCHEMY_API_KEY=

# true = every button only simulates on chain (eth_call), nothing is sent. Start with true.
RH_PRACTICE_MODE=true

# Optional PIN for other devices. Empty = this Mac, home Wi-Fi and Tailscale trade without a PIN (public IPs never).
RH_WEB_PIN=

# Port of RH Terminal. Empty = 8892. Change it if another app on this Mac uses that port.
RH_WEB_PORT=

# Your LP bankroll in dollars and the default ladder size (capped at bankroll x 5% / 0.9).
RH_BANKROLL_USD=
RH_SIZE_USD=

# Optional: a wallet to show in Portfolio when no key is set (read-only).
RH_WALLET=

# Optional: Telegram for PING / auto-exit messages (bot from @BotFather, chat id from @userinfobot).
# Empty = DLMM_TG_BOT_TOKEN / DLMM_TG_CHAT_ID are used if those are set.
RH_TG_BOT_TOKEN=
RH_TG_CHAT_ID=
