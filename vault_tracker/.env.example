# Alamat on-chain vault Hedgin / wallet leader (base58, bukan slug)
VAULT_ADDRESS=
# Wallet kamu (opsional) untuk status "sudah copy / belum"
FOLLOWER_ADDRESS=

# RPC Solana (Helius / Alchemy / QuickNode). Kosong = public RPC (cepat kena rate limit)
SOLANA_RPC_URL=

# Range LP kamu: mirror | pct:-10,10 | scale:0.5
COPY_MODE=pct:-10,10
POLL_INTERVAL=30
HISTORY_LIMIT=300
MIN_ALERT_USD=5
# ALERT_TYPES=OPEN,CLOSE,ADD,REMOVE,REBALANCE,SWAP,OUT_OF_RANGE,IN_RANGE

# Telegram (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord (opsional)
DISCORD_WEBHOOK_URL=
# Jupiter API key (opsional, untuk api.jup.ag; tanpa key pakai lite-api.jup.ag)
JUPITER_API_KEY=

# Bot copytrade: off | dry (rencana + simulasi, tanpa transaksi) | live (kirim transaksi sungguhan)
COPY_RUN=off
# File keypair wallet bot (buat dengan: python -m vault_tracker copy-wallet new). Private key TIDAK ditaruh di sini.
COPY_KEYPAIR=
COPY_BUDGET=SOL
# SOL only: deposit SOL saja (one-sided, tanpa beli token); pool tanpa SOL dilewati
COPY_SOL_ONLY=0
# Ukuran copy: vault (% mengikuti bobot vault) | usd (COPY_SIZE_USD tetap) | ratio (COPY_SIZE_RATIO x posisi vault)
COPY_SIZE_MODE=vault
COPY_FOLLOW_PCT=100
COPY_SIZE_USD=20
COPY_SIZE_RATIO=0
COPY_MAX_USD=100
COPY_MAX_OPEN=3
COPY_RESERVE_SOL=0.1
COPY_MAX_PRICE_MOVE=2
COPY_MAX_EVENT_AGE=180
COPY_STRATEGY=spot
COPY_SLIPPAGE_BPS=100
COPY_EXIT_SWAP=1
COPY_PRIORITY=50000
COPY_MAX_NEW_BIN_ARRAYS=1
# Ikut tambah/tarik likuiditas vault secara proporsional (1/0); abaikan aksi di bawah USD ini
COPY_FOLLOW_LIQUIDITY=1
COPY_MIN_ACTION_USD=2
# Exit sendiri: take profit / stop loss (% dari modal, 0 = mati), tutup kalau out of range > N menit
COPY_TP_PCT=0
COPY_SL_PCT=0
COPY_OOR_CLOSE_MIN=0
# Terima perintah /status /tarik /tambah /tutup /darurat /jeda /lanjut dari chat Telegram kamu
COPY_TG_COMMANDS=1
